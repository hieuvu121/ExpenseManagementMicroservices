# Copy to .env and fill in real values. .env is gitignored — never commit it.
#   cp .env.example .env

# --- Database ---
# MYSQL_ROOT_PASSWORD initialises the mysql container on first start; if you
# change it after the volume exists you must recreate the volume.
DB_USERNAME=root
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# --- Mail ---
# For Gmail this must be an App Password, not the account password.
# email-service cannot deliver locally, so activation tokens are read straight
# from the database (see perf/seed.sh).
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_EMAIL=you@example.com

# --- JWT ---
# Must be long enough for the HMAC algorithm auth-service uses. Changing this
# invalidates every issued token.
JWT_SECRET=generate-a-long-random-string

# --- OpenAI (ai-service) ---
OPENAI_API_KEY=sk-your-key-here

# --- URLs ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:8080
